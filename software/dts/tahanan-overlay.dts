// SPDX-License-Identifier: GPL-2.0
// Tahanan Hub rev A board overlay for Raspberry Pi Compute Module 5 (BCM2712 + RP1).
// Build: dtc -@ -I dts -O dtb -o tahanan.dtbo tahanan-overlay.dts   (or in-tree, see software/README.md)
// Status: written against the raspberrypi/linux rpi-6.12.y device tree labels. NOT yet run on hardware.
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/sound/tlv320aic31xx.h>

/ {
	compatible = "brcm,bcm2712";

	fragment@0 {
		target-path = "/";
		__overlay__ {
			/* Y1: 12.288 MHz oscillator feeding the codec MCLK pin */
			tahanan_mclk: tahanan-codec-mclk {
				compatible = "fixed-clock";
				#clock-cells = <0>;
				clock-frequency = <12288000>;
			};

			tahanan_3v3: regulator-tahanan-3v3 {
				compatible = "regulator-fixed";
				regulator-name = "tahanan-3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
			tahanan_1v8: regulator-tahanan-1v8 {
				compatible = "regulator-fixed";
				regulator-name = "tahanan-1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};
			tahanan_5v: regulator-tahanan-5v {
				compatible = "regulator-fixed";
				regulator-name = "tahanan-5v-spk";
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				regulator-always-on;
			};

			/* Codec is bit and frame clock master (clocked by Y1); the SoC I2S block is the consumer. */
			tahanan_sound: sound {
				compatible = "simple-audio-card";
				simple-audio-card,name = "TahananHub";
				simple-audio-card,format = "i2s";
				simple-audio-card,bitclock-master = <&tahanan_codec_dai>;
				simple-audio-card,frame-master = <&tahanan_codec_dai>;
				simple-audio-card,widgets =
					"Speaker", "Speaker",
					"Microphone", "Mic";
				simple-audio-card,routing =
					"Speaker", "SPK",
					"MIC1LP", "Mic",
					"MIC1LM", "Mic";
				simple-audio-card,cpu {
					sound-dai = <&i2s_clk_consumer>;
				};
				tahanan_codec_dai: simple-audio-card,codec {
					sound-dai = <&tahanan_codec>;
					clocks = <&tahanan_mclk>;
				};
			};

			tahanan_keys: gpio-keys {
				compatible = "gpio-keys";
				user {
					label = "tahanan:user";
					gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
					linux,code = <KEY_PROG1>;
					debounce-interval = <30>;
				};
				mic-enabled {
					/* SW4: high when the microphone is powered */
					label = "tahanan:mic-enabled";
					gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
					linux,input-type = <EV_SW>;
					linux,code = <SW_MUTE_DEVICE>;
					debounce-interval = <50>;
				};
				poe-type4 {
					/* U18 optocoupler: low when the PSE identified itself as 802.3bt Type 4 */
					label = "tahanan:poe-type4";
					gpios = <&gpio 34 GPIO_ACTIVE_LOW>;
					linux,input-type = <EV_SW>;
					linux,code = <SW_DOCK>;
					debounce-interval = <100>;
				};
			};

			tahanan_leds: leds {
				compatible = "gpio-leds";
				led-user {
					label = "tahanan:blue:user";
					gpios = <&gpio 26 GPIO_ACTIVE_HIGH>;
					default-state = "off";
				};
			};
		};
	};

	fragment@1 {
		target = <&i2s_clk_consumer>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			clock-frequency = <400000>;

			tahanan_codec: audio-codec@18 {
				compatible = "ti,tlv320aic3100";
				reg = <0x18>;
				#sound-dai-cells = <0>;
				reset-gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
				ai31xx-micbias-vg = <MICBIAS_OFF>;   /* MK1 runs from +3V3A through SW4 */
				HPVDD-supply = <&tahanan_3v3>;
				SPRVDD-supply = <&tahanan_5v>;
				SPLVDD-supply = <&tahanan_5v>;
				AVDD-supply = <&tahanan_3v3>;
				IOVDD-supply = <&tahanan_3v3>;
				DVDD-supply = <&tahanan_1v8>;
			};
			/* 0x28: STUSB4500 USB-PD sink. No kernel driver is bound; status is read from user space. */
		};
	};

	fragment@3 {
		target = <&gpio>;
		__overlay__ {
			/* Radio control lines idle high; user space (universal-silabs-flasher, add-ons) drives them. */
			tahanan_radio_pins: tahanan-radio-pins {
				pins = "gpio22", "gpio23", "gpio24", "gpio25";
				function = "gpio";
				bias-pull-up;
			};
		};
	};
};
