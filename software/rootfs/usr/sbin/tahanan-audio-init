#!/bin/sh
# One-shot ALSA mixer defaults for the TLV320AIC3100 (card "TahananHub"), run by tahanan-audio-init.service.
# Control names were checked against sound/soc/codecs/tlv320aic31xx.c in the kernel that Home Assistant OS
# 18.5 builds. NOT run on hardware: confirm with `amixer -c TahananHub scontrols` on first bring-up.
C="amixer -q -c TahananHub"
# playback: I2S -> mono mix -> left DAC -> output mixer -> speaker switch -> class-D
$C sset 'DAC Left Input' 'Mono'
$C sset 'DAC' 0dB
$C sset 'Output Left From Left DAC' on
$C sset 'Speaker' on
$C sset 'Speaker Analog' 100
$C sset 'Speaker Driver' on
$C sset 'Speaker Driver' 12dB
# capture: differential microphone on MIC1LP / MIC1LM -> PGA -> ADC
$C sset 'MIC1LP P-Terminal' 'FFR 10 Ohm'
$C sset 'MIC1LM M-Terminal' 'FFR 10 Ohm'
$C sset 'Mic PGA' 20dB
$C sset 'ADC' on
$C sset 'ADC' 0dB
exit 0
